<Window x:Class="AutoTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrack"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas Background="#FFBDE6CD">
        <!-- ListBox -->
        <Label x:Name="lbl_vehiclesList" Canvas.Left="20" Canvas.Top="20" Content="Vehicles List:" FontWeight="Bold"/>
        <ListBox x:Name="lstbox_showVehicles" DisplayMemberPath="Model" Canvas.Left="20" Canvas.Top="50" Width="250" Height="303" HorizontalAlignment="Center" 
                 VerticalAlignment="Top" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="lstbox_showVehicles_SelectionChanged" />

        <!-- Common Fields -->
        <Label x:Name="lbl_id" Canvas.Left="300" Canvas.Top="30" Content="ID:"/>
        <TextBox x:Name="txt_id" Canvas.Left="420" Canvas.Top="30" Width="200" />

        <Label x:Name="lbl_model" Canvas.Left="300" Canvas.Top="70" Content="Model:"/>
        <TextBox x:Name="txt_model" Canvas.Left="420" Canvas.Top="70" Width="200"/>

        <Label x:Name="lbl_baseCost" Canvas.Left="300" Canvas.Top="110" Content="Base Cost:"/>
        <TextBox x:Name="txt_baseCost" Canvas.Left="420" Canvas.Top="110" Width="200"/>

        <!-- Radio Buttons -->
        <Label x:Name="lbl_vehicleType" Canvas.Left="300" Canvas.Top="150" Content="Vehicle Type:"/>
        <RadioButton x:Name="rdo_gas" Canvas.Left="420" Canvas.Top="150" Content="Gas" GroupName="VehicleType" Checked="rdo_gas_Checked"/>
        <RadioButton x:Name="rdo_electric" Canvas.Left="500" Canvas.Top="150" Content="Electric" GroupName="VehicleType" Checked="rdo_electric_Checked"/>

        <!-- Dynamic Labels and Fields -->
        <Label x:Name="lbl_field1" Canvas.Left="300" Canvas.Top="190" Content="Field 1:"/>
        <TextBox x:Name="txt_field1" Canvas.Left="420" Canvas.Top="190" Width="200" />

        <Label x:Name="lbl_field2" Canvas.Left="300" Canvas.Top="230" Content="Field 2:"/>
        <TextBox x:Name="txt_field2" Canvas.Left="420" Canvas.Top="230" Width="200"/>

        <!-- Total Cost Output -->
        <Label x:Name="lbl_totalCost" Canvas.Left="300" Canvas.Top="270" Content="Total Operating Cost:"/>
        <TextBox x:Name="txt_totalCost" Canvas.Left="420" Canvas.Top="270" Width="200" IsReadOnly="True"/>

        <!-- Buttons -->       
        <Button x:Name="btn_Clac" Canvas.Left="390" Canvas.Top="320" Width="80" Content="Calculate" Click="btn_Clac_Click"/>
        <Button x:Name="btn_Delete" Canvas.Left="480" Canvas.Top="320" Width="80" Content="Delete" Click="btn_Delete_Click"/>
        <Button x:Name="btn_Close" Canvas.Left="570" Canvas.Top="320" Width="80" Content="Close" Click="btn_Close_Click"/>

    </Canvas>

</Window>
